# Limites de proteção de disco (GB)
DUBFORGE_DISK_WARNING_GB=20
DUBFORGE_MIN_START_DISK_GB=10
DUBFORGE_MIN_RUNTIME_DISK_GB=5
DUBFORGE_RESUME_DISK_GB=7

# Estimativa conservadora usada pelo agendador automático por VoxCPM
DUBFORGE_VOXCPM_WORKER_GB=11
DUBFORGE_VRAM_RESERVE_GB=4

# Pastas opcionais
# DUBFORGE_PROJECTS_DIR=/workspace/DubForge/projects
# ZAST_TRANSLATE_PATH=/workspace/ZastTranslate
